# 时区（https://en.wikipedia.org/wiki/List_of_tz_database_time_zones）
TZ=Asia/Shanghai

# Web 界面访问端口
WEB_PORT=8080

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 说明：
# 所有服务默认使用 host 网络模式，以便 go2rtc 直接发现局域网 ONVIF 设备。
# 如需改用 bridge 网络，请把 docker-compose.yml 中的 network_mode 改为自建网络，
# 并相应修改 OPENSIGHT_GO2RTC_API 的地址。
