# 时区（https://en.wikipedia.org/wiki/List_of_tz_database_time_zones）
TZ=Asia/Shanghai

# Web 界面访问端口
WEB_PORT=8080

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 局域网扫描默认网段（摄像头所在网段）。留空则尝试自动推断宿主机网段。
# 例：LAN_SUBNET=192.168.1.0/24
LAN_SUBNET=

# 网络说明：
# go2rtc / worker / api / web 均使用 bridge 网络：
#   - worker 通过 http://go2rtc:1984 拉流；
#   - web 的 nginx 用 /api 反代 api:8000，用 /rtc 反代 go2rtc:1984（含 WebSocket Upgrade）；
#   - go2rtc 显式映射 1984/8554/8555/8556，浏览器经同源 /rtc 建立 WebRTC 预览。
# bridge 下 ONVIF 组播发现会受限，请用页面上的"扫描摄像头"做单播网段扫描。
# Windows Docker Desktop 下若自动推断的扫描网段不对，请显式设置上面的 LAN_SUBNET。
